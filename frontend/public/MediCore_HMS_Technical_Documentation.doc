            <th>Access Clearance</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>?? Doctor Portal</strong></td>
            <td><code>medicore.doctor@gmail.com</code></td>
            <td><code>Doctor@2026</code></td>
            <td>Clinical Station, Patient Rounds, E-Prescriptions, Tele-Chat</td>
        </tr>
        <tr>
            <td><strong>????? Nurse Portal</strong></td>
            <td><code>medicore.nurse@gmail.com</code></td>
